# Copy to .env. These are placeholders for a local database in Docker, not real credentials.
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker

# The host port the database listens on is overridable, for when something else already holds 5432.
# If you set it, use the same port in DATABASE_URL above.
# DB_PORT=5432

# The key clients send to this service is generated, not chosen, so no value is given here.
# Run `bun run setApiKey --burn-after-reading` to write one into your .env; until then every request is refused.
# API_KEY=

# The backup needs a pg_dump at least as new as the database (Postgres 16 in Docker). If yours is older,
# this runs the container's own; see "Backups" in the README. Unset, `pg_dump` from your PATH is used.
# PG_DUMP_BIN=scripts/pg_dump-docker.sh

# Signing in to the web app (see "Signing in" in the README). One mode at a time; unset means no login.
# AUTH_MODE=password
#   password: run `bun run set-password` to write AUTH_PASSWORD_HASH here. Never put the password itself here.
# AUTH_PASSWORD_HASH=
#   oidc: one account at a standard OpenID Connect provider. Values below are placeholders.
# OIDC_ISSUER=https://issuer.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
# OIDC_ALLOWED_SUBJECT=
# OIDC_ALLOWED_EMAIL=
# OIDC_SCOPES=openid email
# Set when the app is reached over HTTPS through a proxy, so the session cookie is marked Secure.
# AUTH_COOKIE_SECURE=true

# Optional: Open Notebook, for the notebook_* MCP tools (docs/open-notebook.md). Unset, those tools
# are not registered. The key is the OPEN_NOTEBOOK_PASSWORD you gave the notebook; leave it unset
# for a notebook without a password.
# OPEN_NOTEBOOK_URL=http://localhost:5055
# OPEN_NOTEBOOK_API_KEY=
