{
  "extends": ["@open-tomato/typescript-config/bun", "@open-tomato/typescript-config/react"],
  "compilerOptions": {
    // The react flavor's lib list replaces the bun flavor's; bun's own types
    // need the async-iterable DOM lib on top of it.
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "target": "ESNext",
    // The react flavor resets module to ESNext; bun runs with Preserve.
    "module": "Preserve",
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    // Off: this is an app that never emits declarations, and ~190 exports are
    // Zod schemas and Drizzle tables whose inferred types cannot be written by
    // hand. Follow-up: turn it on if any module is ever published as a package.
    "isolatedDeclarations": false
  }
}
